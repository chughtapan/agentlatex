{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch|write_file|edit_file|exec|exec_command|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/guard_agent_edits.py"
          }
        ]
      }
    ]
  }
}
